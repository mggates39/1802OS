.align 0x100
;UART BUFFERS
UARTBUFFERSIZE equ 0x100 ; 256 bytes 
UARTOUTBUFFER equ $
UARTINBUFFER equ UARTOUTBUFFER + UARTBUFFERSIZE

; STACK SIZE AND LOCATION
STACKSIZE equ 0x100 - RETURNSTACKSIZE ; 256 - 32 bytes for the stack
RETURNSTACKSIZE equ 0x20 ; 32 bytes for return stack
RETURNSTACKTOP equ UARTINBUFFER + UARTBUFFERSIZE + RETURNSTACKSIZE - 1; FDFF, grows down
STACKTOP equ RETURNSTACKTOP + STACKSIZE

USERRAM equ STACKTOP + 1