; Equates for all standard locations

BOOT equ BEGINNING
ROMSTART equ BEGINNING
RAMSTART equ STACKTOP + 1
REG0 equ 00h
REG1 equ 01h
REG2 equ 02h
REG3 equ 03h
REG4 equ 04h
REG5 equ 05h
REG6 equ 06h
REG7 equ 07h
REG8 equ 08h
REG9 equ 09h
REG10 equ 0Ah
REG11 equ 0Bh
REG12 equ 0Ch
REG13 equ 0Dh
REG14 equ 0Eh
REG15 equ 0Fh

PC equ REG0
INTERRUPT equ REG1 ; pointer to interrupt handler
STACK equ REG2 

GOSUBREG equ REG3 ; 3 registers for GOSUB functionality
RETURNSTACK equ REG4 ; seperate stack for GOSUB returns
ARGUMENTS equ REG5 ; pointer to caller/arguments

SCRATCHREG equ REG6 ; never trust this to not be clobbered
UARTREG equ REG7 ; FOR consuming the read buffer or
                  ; adding to the send buffer

INTERRUPTREG2 equ REG8 ; for use in interrupt handler
INTERRUPTREG equ REG9 ; for use in interrupt handler

USERREG0 equ REG10
USERREG1 equ REG11
USERREG2 equ REG12
USERREG3 equ REG13
USERREG4 equ REG14
USERREG5 equ REG15