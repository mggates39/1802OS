; place to define common macros

CLEARREG    macro REG ; REG set to 0000H
    LDI 00h
    PHI REG
    PLO REG
    endm

LOADREG    macro ADDR, REG ; ADDRESS, REG
    LDI (ADDR >> 8)
    PHI REG
    LDI (ADDR & 0ffh)
    PLO REG
    endm

LOADREGLDN     macro ADDR, REG; ADDRESS, REG
    LDI (ADDR >> 8)
    PHI REG
    LDI (ADDR & 0ffh)
    PLO REG
    LDN REG
    endm 

LOADREGCLR     macro ADDR, REG ; ADDRESS, REG
    LDI (ADDR >> 8)
    PHI REG
    LDI (ADDR & 0ffh)
    PLO REG
    LDI 00h
    STR REG
    endm 


; I/O interface macros

; SETIO register/port
SETIO    macro IOPORT
    LDI IOPORT ; set register/device to IOPORT
    DEC STACK
    STR STACK
    OUT 001b ; latch i/o register/device, increments R(5)
    endm 

; WRITEIO value
WRITEIO    macro VALUE
    LDI VALUE
    DEC STACK
    STR STACK
    OUT 100b ; send VALUE to IO, increments STACK
    endm

; READIO value
READIO    macro 
    INP 110b ; puts value on stack
    DEC STACK ; move stack pointer
    endm


; print byte in D
PRCHAR  macro
    STR STACK
    DEC STACK
    GOSUB PRCHAR_SUB
    endm


; print byte in D as hex pair
PRBYTE  macro
    STR STACK
    DEC  STACK
    GOSUB PRBYTE_SUB
    endm

; print word in argument
PRWORD  macro ARG
    LDI (ARG >> 8)
    PRBYTE
    LDI (ARG & 0ffh)
    PRBYTE
    endm

;print "word-word" from arguments
PRRANGE macro ARG1, ARG2
    PRWORD ARG1
    LDI "-"
    PRCHAR
    PRWORD ARG2
    endm

;print static string
PRSTRING    macro STR
    GOSUB PRSTR
    db STR, 0
    endm

;print CRLF terminated static string
PRSTRINGCRLF    macro STR
    GOSUB PRSTR
    db STR, 0
    PRCRLF
    endm


;claude authored interrupt enable/disable

DISABLE_INTERRUPTS  macro
    LDI (XPSAVE >> 8)
    PHI SCRATCHREG
    LDI (XPSAVE & 0ffh)
    PLO SCRATCHREG
    SEX SCRATCHREG
    DIS              ; IE <- 0, X,P reloaded unchanged, R(SCRATCHREG)+1
    SEX STACK
    endm

ENABLE_INTERRUPTS   macro
    LDI (XPSAVE >> 8)
    PHI SCRATCHREG
    LDI (XPSAVE & 0ffh)
    PLO SCRATCHREG
    SEX SCRATCHREG
    RET              ; IE <- 1, X,P reloaded unchanged, R(SCRATCHREG)+1
    SEX STACK
    endm

; prints CR/LF
; restores d to value on entry
PRCRLF  macro
    DEC STACK
    STR STACK
    LDI 13
    PRCHAR
    LDI 10
    PRCHAR
    LDN STACK
    INC STACK
    endm

; CLC
CLEARCARRY  macro
    LDI 00h
    SHR
    endm

; SEC
SETCARRY    macro
    LDI 01h
    SHR
    endm


; for wozmon, jump execution to this address
JUMPEXECUTE macro TARGET
    LDI (TMPJMPM >> 8)
    PHI ARGUMENTS
    LDI (TMPJMPM & 0FFh)
    PLO ARGUMENTS
    SEP ARGUMENTS
TMPJMPM: 
    GHI TARGET
    PHI PC
    GLO TARGET
    PLO PC
    SEP PC
    endm    

; 4 bit left shift from D to %%1 low to %%1 high
; for wozmon
biglshift    macro LOC
    DEC STACK
    SHL
    STR STACK
    GLO LOC
    SHLC
    PLO LOC
    GHI LOC
    SHLC
    PHI LOC
    LDN STACK
    SHL
    STR STACK
    GLO LOC
    SHLC
    PLO LOC
    GHI LOC
    SHLC
    PHI LOC
    LDN STACK
    SHL
    STR STACK
    GLO LOC
    SHLC
    PLO LOC
    GHI LOC
    SHLC
    PHI LOC
    LDN STACK
    SHL
    STR STACK
    GLO LOC
    SHLC
    PLO LOC
    GHI LOC
    SHLC
    PHI LOC
    INC STACK
    endm

;
;   GOSUB Support Macros
;
GOSUB   macro ADDR
;preserves D for use in subroutine
    DEC STACK
    STR STACK
    LDI (CALL) >> 8
    PHI GOSUBREG
    LDI (CALL) & 0ffh
    PLO GOSUBREG
    LDN STACK
    INC STACK
    SEP GOSUBREG
    dw ADDR
    endm

RETSUB  macro
;preserves D for return value from subroutine
    DEC STACK
    STR STACK
    LDI (RETURN) >> 8
    PHI GOSUBREG
    LDI (RETURN) & 0ffh
    PLO GOSUBREG
    LDN STACK
    INC STACK
    SEP GOSUBREG
    endm

;
; RTC support Macros
;
GETCLOCK    macro BUF
    GOSUB GTCLOCK
    dw BUF
    endm

DISPLAYCLOCK    macro DISPTIME
    GOSUB DISPCLOCK
    dw DISPTIME
    endm

CLOCKDIGITDISP  macro REG, STR
    LDN REG
    PRBYTE    
    PRSTRING STR
    INC REG
    endm

