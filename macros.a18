; place to define common macros

; replacesments for register op codes
; allowing the use of constants for registers

LDN_R   macro REG
    db 00H | REG ; LDN REG
    endm

INC_R   macro REG
    db 010h | REG ; INC REG
    endm

DEC_R   macro REG
    db 020h | REG ; DEC REG
    endm

LDA_R   macro REG
    db 040h | REG ; LDA REG
    endm

STR_R   macro REG
    db 050h | REG ; STR REG
    endm

GLO_R    macro REG
    db 080h | REG ; GLO REG
    endm

GHI_R    macro REG
    db 090 | REG ; GHI REG
    endm

PLO_R    macro REG
    db 0A0h | REG ; PLO REG
    endm

PHI_R    macro REG
    db 0B0h | REG ; PHI REG
    endm

SEP_R    macro REG
    db 0D0h | REG ; SEP REG
    endm

SEX_R    macro REG
    db 0E0h | REG ; SEX REG
    endm


CLEARREG    macro REG ; REG set to 0000H
    LDI 00h
    PHI REG
    PLO REG
    endm

LOADREG    macro ADDR, REG ; ADDRESS, REG
    LDI (ADDR) >> 8
    PHI REG
    LDI (ADDR) && 0ffh
    PLO REG
    endm

LOADREGLDN     macro ADDR, REG; ADDRESS, REG
    LDI (ADDR) >> 8
    PHI REG
    LDI (ADDR) && 0ffh
    PLO REG
    LDN REG
    endm 

LOADREGCLR     macro ADDR, REG ; ADDRESS, REG
    LDI (ADDR) >> 8
    PHI REG
    LDI (ADDR) && 0ffh
    PLO REG
    LDI 00h
    STR REG
    endm 


; I/O interface macros

; SETIO register/port
SETIO    macro IOPORT
    LDI IOPORT ; set register/device to IOPORT
    DEC STACK
    STR STACK
    OUT 001b ; latch i/o register/device, increments R(5)
    endm 

; WRITEIO value
WRITEIO    macro VALUE
    LDI VALUE
    DEC STACK
    STR STACK
    OUT 100b ; send VALUE to IO, increments STACK
    endm

; READIO value
READIO    macro 
    INP 110b ; puts value on stack
    DEC STACK ; move stack pointer
    endm


; print byte in D
PRCHAR  macro
    STR STACK
    DEC STACK
    GOSUB PRCHAR_SUB
    endm


; print byte in D as hex pair
PRBYTE  macro
    STR STACK
    DEC  STACK
    GOSUB PRBYTE_SUB
    endm

; print word in argument
PRWORD  macro ARG
    LDI (ARG) >> 8
    PRBYTE
    LDI (ARG)
    PRBYTE
    endm

;print "word-word" from arguments
PRRANGE macro ARG1, ARG2
    PRWORD ARG1
    LDI "-"
    PRCHAR
    PRWORD ARG2
    endm

;print static string
PRSTRING    macro STR
    GOSUB PRSTR
    db STR, 0
    endm

;print CRLF terminated static string
PRSTRINGCRLF    macro STR
    GOSUB PRSTR
    db STR, 0
    PRCRLF
    endm


;claude authored interrupt enable/disable

DISABLE_INTERRUPTS  macro
    LDI (XPSAVE) >> 8
    PHI SCRATCHREG
    LDI (XPSAVE) && 0ffh
    PLO SCRATCHREG
    SEX SCRATCHREG
    DIS              ; IE <- 0, X,P reloaded unchanged, R(SCRATCHREG)+1
    SEX STACK
    endm

ENABLE_INTERRUPTS   macro
    LDI (XPSAVE) >> 8
    PHI SCRATCHREG
    LDI (XPSAVE) && 0ffh
    PLO SCRATCHREG
    SEX SCRATCHREG
    RET              ; IE <- 1, X,P reloaded unchanged, R(SCRATCHREG)+1
    SEX STACK
    endm

; prints CR/LF
; restores d to value on entry
PRCRLF  macro
    DEC STACK
    STR STACK
    LDI 13
    PRCHAR
    LDI 10
    PRCHAR
    LDN STACK
    INC STACK
    endm

; CLC
CLEARCARRY  macro
    LDI 00h
    SHR
    endm

; SEC
SETCARRY    macro
    LDI 01h
    SHR
    endm

; for wozmon, jump execution to this address
JUMPEXECUTE macro TARG
    LDI a.1 (TMPJMP%%M)
    PHI ARGUMENTS
    LDI a.0 (TMPJMP%%M)
    PLO ARGUMENTS
    SEP ARGUMENTS
TMPJMP%%M: 
    GHI TARG
    PHI PC
    GLO TARG
    PLO PC
    SEP PC
    endm    

; 4 bit left shift from D to %%1 low to %%1 high
; for wozmon
biglshift    macro LOC
    DEC STACK
    SHL
    STR STACK
    GLO LOC
    SHLC
    PLO LOC
    GHI LOC
    SHLC
    PHI LOC
    LDN STACK
    SHL
    STR STACK
    GLO LOC
    SHLC
    PLO LOC
    GHI LOC
    SHLC
    PHI LOC
    LDN STACK
    SHL
    STR STACK
    GLO LOC
    SHLC
    PLO LOC
    GHI LOC
    SHLC
    PHI LOC
    LDN STACK
    SHL
    STR STACK
    GLO LOC
    SHLC
    PLO LOC
    GHI LOC
    SHLC
    PHI LOC
    INC STACK
    endm

