; Interrupt Handler
; Loops back to beginning address to restore R(1)
INTEND: 
    INC STACK 
    LDA STACK
    SHR
    LDA STACK ; restore D and stack to original position
    RET

INTERRUPTHANDLER:
    SEX STACK
    DEC STACK ; we don't know if stack is mid-use
    SAV ; save X,P
    DEC STACK
    STR STACK ; save D
    DEC STACK
    SHLC
    STR STACK ; save DL 

; check UART interrupts
    DEC STACK
    SETIO 02h
    DEC STACK
    INP 110b ; read byte from UART to stack and D
    ANI 01h ; mask interrupt pending bit
    JNZ CHECKRTC
    LDN STACK
    ANI 0Eh ; mask interrupt ID
    SMI 02h ; TX
    JZ HANDLETX
    LDN STACK
    ANI 0Eh ; mask interrupt ID
    SMI 04h ; RX
    JZ HANDLERX
    LDN STACK
    ANI 0Eh ; mask interrupt ID
    SMI 06h ; RLS
    JZ HANDLERLS

HANDLETX:
    LOADREGLDN XOFFPENDING, INTERRUPTREG
    JZ SKIPXOFF
    SETIO 00h ; UART data port
    SEX INTERRUPTREG
    OUT 100b 
    SEX STACK
    DEC INTERRUPTREG
    LDI 00H
    STR INTERRUPTREG
    JMP DONEUART

SKIPXOFF:
    LOADREGLDN UARTSENDBUFFERHEAD, INTERRUPTREG ; check byte count in out buffer
    STR STACK
    LOADREGLDN UARTSENDBUFFERTAIL, INTERRUPTREG2 ; check byte count in out buffer
    SM
    JZ STOPTRANSMITINTERRUPTS ; skip if buffer is 0 bytes

; tail ptr already in INTERRUPTREG2 from 0 byte check
    LDN INTERRUPTREG2 ; get tail pointer value
    PLO INTERRUPTREG ; push in to reg
    LDI (UARTOUTBUFFER >> 8)
    PHI INTERRUPTREG
    SETIO 00h; UART data port
    SEX INTERRUPTREG
    OUT 100b 
    GLO INTERRUPTREG ; get incremented tail pointer
    STR INTERRUPTREG2 ; overwrite old tail value
    SEX STACK
; compare tail and head to see if bytes left
    LDN INTERRUPTREG2
    DEC STACK
    STR STACK
    LOADREGLDN UARTSENDBUFFERHEAD, INTERRUPTREG
    SM
    INC STACK
    JNZ DONEUART ; if not 0, skip disable uart
; char count is zero, stop interrupts
STOPTRANSMITINTERRUPTS:
    DEC STACK ; don't overwrite interrupt status
    SETIO 01h ; IO to int register
    INP 110b ; get flags
    ANI 0FDh ; 11111101 to set transmit int to 0
    STR STACK ; push to stack
    OUT 100b    ; OUT grabs from stack, increments back to ISR
    JMP DONEUART

HANDLERX:
    LOADREG UARTRECVBUFFERHEAD, INTERRUPTREG
    LDI (UARTINBUFFER >> 8) ; pointer to buffer start
    PHI INTERRUPTREG2 
    LDN INTERRUPTREG ; pointer to head value
    PLO INTERRUPTREG2 
    SETIO 00h
    DEC STACK
    INP 110b
    SMI 03h ; check if ctrl-c
    JZ WARMBOOTJMP
    SMI 017h ; check if ctrl-Z
    JZ REBOOT
    SMI 02h ; check if ctrl-backslash
    JZ HARDBOOT
    LDN STACK
    INC STACK
    STR INTERRUPTREG2 ; store byte in head
    INC INTERRUPTREG2 ; inc pointer
    GLO INTERRUPTREG2 ; 
    STR INTERRUPTREG  ;
    LOADREGLDN UARTRECVNEWFLAG, INTERRUPTREG ; pointer to new char flag
    ADI 01h            ; set flag to number of chars
    STR INTERRUPTREG  ;
; INTERRUPTREG is pointer to byte count
    SMI 0C0h
    JDF SENDXOFF

DONEUART:
    INC STACK
    JMP INTEND

CHECKRTC: ; comes with STACK decremented
    SETIO 01Eh
    INP 110b
    ANI 010h ; interrupt enabled?
    JZ INTEND ; no RTC interrupt
    LDN STACK
    ANI 080h ; and overflow flag set
    JZ INTEND
; clear interrupt & enable new interrupt

; refresh time variable in memory every 1hz

    LOADREG TIMEBASE, INTERRUPTREG
    SETIO 017h
    INP 110b
    STR INTERRUPTREG
    INC INTERRUPTREG
    SETIO 016h
    INP 110b
    STR INTERRUPTREG
    INC INTERRUPTREG
    SETIO 015h
    INP 110b
    STR INTERRUPTREG
    INC INTERRUPTREG
    SETIO 013h
    INP 110b
    STR INTERRUPTREG
    INC INTERRUPTREG
    SETIO 012h
    INP 110b
    STR INTERRUPTREG
    INC INTERRUPTREG
    SETIO 011h
    INP 110b
    STR INTERRUPTREG

    INC STACK    
    SETIO 01Eh
    WRITEIO 010h

    JMP INTEND


HARDBOOT:
    LDI 00h
    PHI PC
    PLO PC
    SEP PC

REBOOT:
    LDI (INITSYSTEM >> 8)
    PHI PC
    LDI (INITSYSTEM & 0ffh)
    PLO PC
    SEP PC

WARMBOOTJMP:
    LDI (WARMBOOT >> 8)
    PHI PC
    LDI (WARMBOOT & 0ffh)
    PLO PC
    SEP PC

SENDXOFF:
    LOADREGLDN FLOWCONTROL, INTERRUPTREG
    JNZ DONEUART
    LDI 0ffh
    STR INTERRUPTREG
    LOADREG XOFFPENDING, INTERRUPTREG
    LDI 013h
    STR INTERRUPTREG
    DEC STACK
    SETIO 01h
    INP 110b ; status byte in D
    ORI 02h ; make sure transmit buffer int bit is on
    STR STACK ; push new status byte to stack
    OUT 100b ; write 

    JMP DONEUART

HANDLERLS:
    SETIO 05h
    INP 110b
    JMP DONEUART

