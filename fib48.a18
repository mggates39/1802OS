REGAL equ USERREG0
REGAM equ USERREG1
REGAH equ USERREG2
REGBL equ USERREG3
REGBM equ USERREG4
REGBH equ USERREG5

FIB48START:
    LDI 00h
    PHI REGAH
    PHI REGBH
    PLO REGAH
    PLO REGBH
    PHI REGAM
    PHI REGBM
    PLO REGAM
    PLO REGBM
    PHI REGAL
    PHI REGBL
    LDI 01h
    PLO REGAL
    PLO REGBL

    PRCRLF
    PRSTRINGCRLF "FIBONACCI"

    PRREG REGAH, REGAM, REGAL
    PRREG REGBH, REGBM, REGBL

FIBLOOP:

    CLEARCARRY
    ADDREG REGAL, REGBL
    ADDREG REGAM, REGBM
    ADDREG REGAH, REGBH
    LBDF OVERFLOW
    PRREG REGAH, REGAM, REGAL

    CLEARCARRY
    ADDREG REGBL, REGAL
    ADDREG REGBM, REGAM
    ADDREG REGBH, REGAH
    LBDF OVERFLOW
    PRREG REGBH, REGBM, REGBL

    LBR FIBLOOP

OVERFLOW: 
    PRSTRING "OVERFLOW!"
    GOSUB LONGDELAY
    LBR NEWLINE

ADDREG  macro ARG_1, ARG_2
    GLO ARG_1
    STR STACK
    GLO ARG_2
    ADC
    PLO ARG_1

    GHI ARG_1
    STR STACK
    GHI ARG_2
    ADC
    PHI ARG_1
    endm

PRREG    macro ARG_1, ARG_2, ARG_3
    GHI ARG_1
    PRBYTE
    GLO ARG_1
    PRBYTE
    GHI ARG_2
    PRBYTE
    GLO ARG_2
    PRBYTE
    GHI ARG_3
    PRBYTE
    GLO ARG_3
    PRBYTE
    PRCRLF
    endm


