REGAL equ USERREG0
REGAM equ USERREG1
REGAH equ USERREG2
REGBL equ USERREG3
REGBM equ USERREG4
REGBH equ USERREG5

FIB48START:
LDI 00h
PHI REGAH
PHI REGBH
PLO REGAH
PLO REGBH
PHI REGAM
PHI REGBM
PLO REGAM
PLO REGBM
PHI REGAL
PHI REGBL
LDI 01h
PLO REGAL
PLO REGBL

PRCRLF
PRSTRINGCRLF "FIBONACCI"

PRREG REGAH, REGAM, REGAL
PRREG REGBH, REGBM, REGBL

FIBLOOP:

CLEARCARRY
ADDREG REGAL, REGBL
ADDREG REGAM, REGBM
ADDREG REGAH, REGBH
LBDF OVERFLOW
PRREG REGAH, REGAM, REGAL

CLEARCARRY
ADDREG REGBL, REGAL
ADDREG REGBM, REGAM
ADDREG REGBH, REGAH
LBDF OVERFLOW
PRREG REGBH, REGBM, REGBL

LBR FIBLOOP

OVERFLOW: 
PRSTRING "OVERFLOW!"
GOSUB LONGDELAY
LBR NEWLINE

.macro ADDREG
GLO %%1
STR STACK
GLO %%2
ADC
PLO %%1

GHI %%1
STR STACK
GHI %%2
ADC
PHI %%1
.end m

.macro PRREG
GHI %%1
PRBYTE
GLO %%1
PRBYTE
GHI %%2
PRBYTE
GLO %%2
PRBYTE
GHI %%3
PRBYTE
GLO %%3
PRBYTE
PRCRLF
.endm


