; GOSUB and RETSUB
; makes possible subroutine calling 
;
; example call to subroutine with immediate argument
;LDI 011h
;GOSUB sub1
;db "Hello", 0

;example subroutine which consumes arguments
;sub1:
;SEX ARGUMENTS
;GETARG:
;LDXA 
;BNZ GETARG
;SEX STACK
;RETSUB

;example subroutine which consumes stack argument
;sub2:
;INC STACK ; get to valid data 
;LDX ; leave stack pointing at "free" byte
;RETSUB

CALL:
    GLO ARGUMENTS ; save previous location
    STR RETURNSTACK
    DEC RETURNSTACK
    GHI ARGUMENTS
    STR RETURNSTACK
    DEC RETURNSTACK
    GLO PC
    PLO ARGUMENTS ; store new calling location as arguments
    GHI PC
    PHI ARGUMENTS
    LDA ARGUMENTS
    PHI PC
    LDA ARGUMENTS
    PLO PC
    SEP PC

RETURN:
    GHI ARGUMENTS
    PHI PC
    GLO ARGUMENTS
    PLO PC
    INC RETURNSTACK
    LDA RETURNSTACK
    PHI ARGUMENTS
    LDN RETURNSTACK
    PLO ARGUMENTS
    SEP PC


GOSUB   macro ADDR
;preserves D for use in subroutine
    DEC STACK
    STR STACK
    LDI (CALL) >> 8
    PHI GOSUBREG
    LDI (CALL) && 0ffh
    PLO GOSUBREG
    LDN STACK
    INC STACK
    SEP GOSUBREG
    dw ADDR
    endm

RETSUB  macro
;preserves D for return value from subroutine
    DEC STACK
    STR STACK
    LDI (RETURN) >> 8
    PHI GOSUBREG
    LDI (RETURN) && 0ffh
    PLO GOSUBREG
    LDN STACK
    INC STACK
    SEP GOSUBREG
    endm


; utility subroutines

LONGDELAY:
    LDI 040h
    LSKP
DELAY:
    if NODELAYS=0
    LDI 01h
    PHI GOSUBREG
    LDI 00h
    PLO GOSUBREG
    else
    LDI 00h
    PHI GOSUBREG
    LDI 01h
    PLO GOSUBREG
    endif
DELAYLOOP:
    DEC GOSUBREG
    GHI GOSUBREG
    LBNZ DELAYLOOP
    GLO GOSUBREG
    LBNZ DELAYLOOP
    RETSUB


; specialty subroutines
