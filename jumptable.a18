; BIOS jump table and constants

LBR INITSYSTEM
CLOCKDISPLAY:
LBR RTCDISPLAY
CLOCKLOOPDISPLAY:
LBR RTCLOOPDISPLAY
FIB256DISPLAY:
LBR FIB256START

.org BEGINNING + 0x70
; 16 bytes for timer start/stop
TIMERSTART:
TIMERSTART_YR: db 0x00
TIMERSTART_MO: db 0x00
TIMERSTART_DA: db 0x00
TIMERSTART_HO: db 0x00
TIMERSTART_MI: db 0x00
TIMERSTART_SE: db 0x00
TIMEREND:
TIMEREND_YR: db 0x00
TIMEREND_MO: db 0x00
TIMEREND_DA: db 0x00
TIMEREND_HO: db 0x00
TIMEREND_MI: db 0x00
TIMEREND_SE: db 0x00



.align 0X10; 16 bytes reserved for OS memory
OSMEM equ $ ; page aligned after ROM code
XPSAVE:   db   0x20        ; encodes X=STACK(2), P=PC(0) — mainline's normal state
UARTSENDBUFFERHEAD: db 0x00
UARTSENDBUFFERTAIL: db 0x00
;UARTSENDOVERFLOWFLAG: db 0x00
UARTRECVBUFFERHEAD: db 0x00
UARTRECVBUFFERTAIL: db 0x00
UARTRECVNEWFLAG: db 0x00
WOZWRITELOW: db 0x00
WOZWRITEHIGH: db 0x00
FLOWCONTROL: db 0x00
XOFFPENDING: db 0x00
DEBUGTEXT: db 0x00
.align 0x20
; HEX lookup for PRBYTE
HEXTABLE: db "0123456789ABCDEF"
; 64 bytes for the wozmon input line buffer
; wozmon buffer has no overflow protection
.align 0x10
WOZMONLINE: db 0x00

