; BIOS jump table and constants

    LBR INITSYSTEM
CLOCKDISPLAY:
    LBR RTCDISPLAY
CLOCKLOOPDISPLAY:
    LBR RTCLOOPDISPLAY
FIB256DISPLAY:
    LBR FIB256START

	org BEGINNING + 70h
; 16 bytes for timer start/stop
TIMEBASE:
TIME_YR: db 00h
TIME_MO: db 00h
TIME_DA: db 00h
TIME_HO: db 00h
TIME_MI: db 00h
TIME_SE: db 00h
TIMERSTART:
TIMERSTART_YR: db 00h
TIMERSTART_MO: db 00h
TIMERSTART_DA: db 00h
TIMERSTART_HO: db 00h
TIMERSTART_MI: db 00h
TIMERSTART_SE: db 00h



    align 10h ; 16 bytes reserved for OS memory
OSMEM equ $ ; page aligned after ROM code
XPSAVE:   db   20h        ; encodes X=STACK(2), P=PC(0) — mainline's normal state
UARTSENDBUFFERHEAD: db 00h
UARTSENDBUFFERTAIL: db 00h
;UARTSENDOVERFLOWFLAG: db 00h
UARTRECVBUFFERHEAD: db 00h
UARTRECVBUFFERTAIL: db 00h
UARTRECVNEWFLAG: db 00h
WOZWRITELOW: db 00h
WOZWRITEHIGH: db 00h
FLOWCONTROL: db 00h
XOFFPENDING: db 00h
DEBUGTEXT: db 00h
    align 20h
; HEX lookup for PRBYTE
HEXTABLE: db "0123456789ABCDEF"
; 80 bytes for the wozmon input line buffer
; wozmon buffer has no overflow protection
    align 10h
WOZMONLINE: db 00h

