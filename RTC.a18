;1E10W to enable IRqs
;1E10W to disable IRQs


RTCINIT:
    SETIO 01Fh
    WRITEIO 01h ; enable clock
    SETIO 01Eh
    WRITEIO 010h
    RETSUB

RTCDISPLAY:
    PRCRLF
    DISPLAYCLOCK TIMEBASE
    PRCRLF
    LBR NEWLINE

RTCLOOPDISPLAY:
    PRCRLF
    PRCRLF
    GETCLOCK TIMERSTART
    DISPLAYCLOCK TIMEBASE
    DEC STACK

RTCLOOP:
    LOADREGLDN TIMERSTART_SE, SCRATCHREG
    STR STACK
SECCHANGE:
    LOADREGLDN TIME_SE, SCRATCHREG
    SD
    BZ SECCHANGE

    GETCLOCK TIMERSTART
    LDI 012h
    PLO USERREG4
BSLOOP:
    LDI 008h
    PRCHAR
    DEC USERREG4
    GLO USERREG4
    LBNZ BSLOOP
    DISPLAYCLOCK TIMEBASE

    LBR RTCLOOP
    LBR NEWLINE

DISPCLOCK:
    LDN ARGUMENTS
    PHI USERREG5
    INC ARGUMENTS
    LDN ARGUMENTS
    PLO USERREG5
    INC ARGUMENTS
    CLOCKDIGITDISP USERREG5, "/"
    CLOCKDIGITDISP USERREG5, "/"
    CLOCKDIGITDISP USERREG5, " "
    CLOCKDIGITDISP USERREG5, ":"
    CLOCKDIGITDISP USERREG5, ":"
    CLOCKDIGITDISP USERREG5, " "
    RETSUB

GTCLOCK:
    DISABLE_INTERRUPTS
    LDN ARGUMENTS
    PHI SCRATCHREG
    INC ARGUMENTS
    LDN ARGUMENTS
    PLO SCRATCHREG
    INC ARGUMENTS
    LDN SCRATCHREG
    DEC STACK
    SETIO 017h
    INP 110b
    STR SCRATCHREG
    INC SCRATCHREG
    SETIO 016h
    INP 110b
    STR SCRATCHREG
    INC SCRATCHREG
    SETIO 015h
    INP 110b
    STR SCRATCHREG
    INC SCRATCHREG
    SETIO 013h
    INP 110b
    STR SCRATCHREG
    INC SCRATCHREG
    SETIO 012h
    INP 110b
    STR SCRATCHREG
    INC SCRATCHREG
    SETIO 011h
    INP 110b
    STR SCRATCHREG
    INC STACK    
    ENABLE_INTERRUPTS
    RETSUB