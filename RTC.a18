RTCINIT:
SETIO 0x1F
WRITEIO 0x00 ; stop clock

SETIO 0x11
WRITEIO 0x00
SETIO 0x12
WRITEIO 0x40
SETIO 0x13
WRITEIO 0x20
SETIO 0x15
WRITEIO 0x14
SETIO 0x16
WRITEIO 0x08
SETIO 0x17
WRITEIO 0x26

SETIO 0x1F
WRITEIO 0x02 ; reset clock dividers
WRITEIO 0x01 ; enable clock
RETSUB

LOOPTIME: db 0x00

RTCLOOPDISPLAY:
LOADREG LOOPTIME, SCRATCHREG
LDI 0xFF
STR_R SCRATCHREG
LBR RTCLOOP

RTCDISPLAY:
LOADREGCLR LOOPTIME, SCRATCHREG
LBR RTCLOOP



RTCLOOP:
PRCRLF
DEC_R STACK

SETIO 0x16
READIO
INC_R STACK
PRBYTE

LDI '/'
PRCHAR

SETIO 0x15
READIO
INC_R STACK
PRBYTE

LDI '/'
PRCHAR

SETIO 0x17
READIO
INC_R STACK
PRBYTE

LDI ' '
PRCHAR

SETIO 0x13
READIO
INC_R STACK
PRBYTE

LDI ':'
PRCHAR

SETIO 0x12
READIO 
INC_R STACK
PRBYTE

LDI ':'
PRCHAR

SETIO 0x11
READIO 
INC_R STACK
PRBYTE

INC_R STACK
LOADREGLDN LOOPTIME, SCRATCHREG
LBZ NEWLINE

GOSUB LONGDELAY
LBR RTCLOOP

