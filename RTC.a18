; Enter 1E10W in the monitor to enable RTC IRQs
; Enter 1E10W in the monitor to disable RTC IRQs


RTCINIT:
    SETIO 01Fh
    WRITEIO 01h ; enable clock
    SETIO 01Eh
    WRITEIO 10h
    RETSUB

RTCDISPLAY:
    PRCRLF
    DISPLAYCLOCK TIMEBASE
    PRCRLF
    JMP NEWLINE

RTCLOOPDISPLAY:
    PRCRLF
    PRCRLF
    GETCLOCK TIMERSTART
    DISPLAYCLOCK TIMEBASE
    DEC STACK

RTCLOOP:
    LOADREGLDN TIMERSTART_SE, SCRATCHREG
    STR STACK
SECCHANGE:
    LOADREGLDN TIME_SE, SCRATCHREG
    SD
    JZ SECCHANGE

    GETCLOCK TIMERSTART
    LDI 12h
    PLO USERREG4
BSLOOP:
    LDI 08h
    PRCHAR
    DEC USERREG4
    GLO USERREG4
    JNZ BSLOOP
    DISPLAYCLOCK TIMEBASE

    JMP RTCLOOP

DISPCLOCK:
    LDN ARGUMENTS
    PHI USERREG5
    INC ARGUMENTS
    LDN ARGUMENTS
    PLO USERREG5
    INC ARGUMENTS
    CLOCKDIGITDISP USERREG5, "/"
    CLOCKDIGITDISP USERREG5, "/"
    CLOCKDIGITDISP USERREG5, " "
    CLOCKDIGITDISP USERREG5, ":"
    CLOCKDIGITDISP USERREG5, ":"
    CLOCKDIGITDISP USERREG5, " "
    RETSUB

GTCLOCK:
    DISABLE_INTERRUPTS
    LDN ARGUMENTS
    PHI SCRATCHREG
    INC ARGUMENTS
    LDN ARGUMENTS
    PLO SCRATCHREG
    INC ARGUMENTS
    LDN SCRATCHREG
    DEC STACK
    SETIO 17h
    INP 110b
    STR SCRATCHREG
    INC SCRATCHREG
    SETIO 16h
    INP 110b
    STR SCRATCHREG
    INC SCRATCHREG
    SETIO 15h
    INP 110b
    STR SCRATCHREG
    INC SCRATCHREG
    SETIO 13h
    INP 110b
    STR SCRATCHREG
    INC SCRATCHREG
    SETIO 12h
    INP 110b
    STR SCRATCHREG
    INC SCRATCHREG
    SETIO 11h
    INP 110b
    STR SCRATCHREG
    INC STACK    
    ENABLE_INTERRUPTS
    RETSUB
