;1E10W to enable IRqs
;1E10W to disable IRQs


RTCINIT:

SETIO 0x1F
WRITEIO 0x01 ; enable clock
SETIO 0x1E
WRITEIO 0x10
RETSUB

LOOPTIME: db 0x00

RTCLOOPDISPLAY:
LOADREG LOOPTIME, SCRATCHREG
LDI 0xFF
STR SCRATCHREG
PRCRLF
LBR RTCLOOP

RTCDISPLAY:
LOADREGCLR LOOPTIME, SCRATCHREG
LDI 0x00
STR SCRATCHREG
PRCRLF


RTCLOOP:
DISPLAYCLOCK TIME
LOADREGLDN LOOPTIME, SCRATCHREG
LBZ NEWLINE

GOSUB LONGDELAY

LDI 0x12
PLO USERREG4
BSLOOP:
LDI 0x08
PRCHAR
DEC USERREG4
GLO USERREG4
BNZ BSLOOP

LBR RTCLOOP

.macro DISPLAYCLOCK
GOSUB DISPCLOCK
.dw %%1
.endm

DISPCLOCK:
LDN ARGUMENTS
PHI USERREG5
INC ARGUMENTS
LDN ARGUMENTS
PLO USERREG5
INC ARGUMENTS
LDN USERREG5
PRBYTE    
PRSTRING "/"
INC USERREG5
LDN USERREG5
PRBYTE    
PRSTRING "/"
INC USERREG5
LDN USERREG5
PRBYTE    
PRSTRING " "
INC USERREG5
LDN USERREG5
PRBYTE    
PRSTRING ":"
INC USERREG5
LDN USERREG5
PRBYTE    
PRSTRING ":"
INC USERREG5
LDN USERREG5
PRBYTE    
PRSTRING " "
RETSUB

.macro GETCLOCK
GOSUB GTCLOCK
.dw %%1
.endm

GTCLOCK:
DISABLE_INTERRUPTS
LDN ARGUMENTS
PHI SCRATCHREG
INC ARGUMENTS
LDN ARGUMENTS
PLO SCRATCHREG
INC ARGUMENTS
LDN SCRATCHREG
DEC STACK
SETIO 0x17
INP 110b
STR SCRATCHREG
INC SCRATCHREG
SETIO 0x16
INP 110b
STR SCRATCHREG
INC SCRATCHREG
SETIO 0x15
INP 110b
STR SCRATCHREG
INC SCRATCHREG
SETIO 0x13
INP 110b
STR SCRATCHREG
INC SCRATCHREG
SETIO 0x12
INP 110b
STR SCRATCHREG
INC SCRATCHREG
SETIO 0x11
INP 110b
STR SCRATCHREG
INC STACK    
ENABLE_INTERRUPTS
RETSUB

