;1E10W to enable IRqs
;1E10W to disable IRQs


RTCINIT:

    SETIO 01Fh
    WRITEIO 01h ; enable clock
    SETIO 01Eh
    WRITEIO 010h
    RETSUB

LOOPTIME: db 00h

RTCLOOPDISPLAY:
    LOADREG LOOPTIME, SCRATCHREG
    LDI 0FFh
    STR SCRATCHREG
    PRCRLF
    LBR RTCLOOP

RTCDISPLAY:
    LOADREGCLR LOOPTIME, SCRATCHREG
    LDI 00h
    STR SCRATCHREG
    PRCRLF


RTCLOOP:
    DISPLAYCLOCK TIMEBASE
    LOADREGLDN LOOPTIME, SCRATCHREG
    LBZ NEWLINE

    GOSUB LONGDELAY

    LDI 012h
    PLO USERREG4
BSLOOP:
    LDI 008h
    PRCHAR
    DEC USERREG4
    GLO USERREG4
    BNZ BSLOOP

    LBR RTCLOOP

DISPCLOCK:
    LDN ARGUMENTS
    PHI USERREG5
    INC ARGUMENTS
    LDN ARGUMENTS
    PLO USERREG5
    INC ARGUMENTS
    LDN USERREG5
    PRBYTE    
    PRSTRING "/"
    INC USERREG5
    LDN USERREG5
    PRBYTE    
    PRSTRING "/"
    INC USERREG5
    LDN USERREG5
    PRBYTE    
    PRSTRING " "
    INC USERREG5
    LDN USERREG5
    PRBYTE    
    PRSTRING ":"
    INC USERREG5
    LDN USERREG5
    PRBYTE    
    PRSTRING ":"
    INC USERREG5
    LDN USERREG5
    PRBYTE    
    PRSTRING " "
    RETSUB

GTCLOCK:
    DISABLE_INTERRUPTS
    LDN ARGUMENTS
    PHI SCRATCHREG
    INC ARGUMENTS
    LDN ARGUMENTS
    PLO SCRATCHREG
    INC ARGUMENTS
    LDN SCRATCHREG
    DEC STACK
    SETIO 017h
    INP 110b
    STR SCRATCHREG
    INC SCRATCHREG
    SETIO 016h
    INP 110b
    STR SCRATCHREG
    INC SCRATCHREG
    SETIO 015h
    INP 110b
    STR SCRATCHREG
    INC SCRATCHREG
    SETIO 013h
    INP 110b
    STR SCRATCHREG
    INC SCRATCHREG
    SETIO 012h
    INP 110b
    STR SCRATCHREG
    INC SCRATCHREG
    SETIO 011h
    INP 110b
    STR SCRATCHREG
    INC STACK    
    ENABLE_INTERRUPTS
    RETSUB

