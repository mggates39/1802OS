BEGINNING equ 0000h
    org BEGINNING
; for debuggin, 1 to disable delays/memory wipe
NODELAYS = 0
SKIPMEMORY = 0

    include jumptable.a18
    include definitions.a18
    include directives.a18
    include macros.a18

    org ROMSTART + 0100h

    include init.a18

    GOSUB UARTINIT
;    GOSUB RTCINIT

    ENABLE_INTERRUPTS

; turn on clock interrupts
    SETIO 1Eh
    WRITEIO 10h

; turn on receive flow control
    SETIO 00h
    WRITEIO 11h

    PRCRLF
    PRCRLF

    include wozmon.a18

    include GOSUB.a18
    include UART.a18
    include RTC.a18
    include interrupt.a18

ENDBIOS:
    include fib256.a18


ENDROM:
    align 0100h
BUFFERS:
    include buffers.a18

