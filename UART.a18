; Subroutine for Init UART, no arguments
UARTINIT:

; LCR to 10000000
    SETIO 03h
    WRITEIO 080h

; Divisor latch 
; 0x000C for 9600 @ 1.8432mHz
; 0x0018 for 9600 @ 3.6864mHz
; 0x0180 for 1200 @ 7.3728mHz
; 0x00C0 for 2400 @ 7.3728mHz
; 0x0030 for 9600 @ 7.3728mHz
; 0x0018 for 19200 @ 7.3728mHz
; 0x000C for 38400 @ 7.3728mHz
; 0x0008 for 57600 @ 7.3728mhz
; 0x0004 for 115200 @ 7.3728mhz
; 0x0001 for 460800 @ 7.3728mHz
    SETIO 01h
    WRITEIO 00h ; high byte
    SETIO 00h
    WRITEIO 08h ; low byte

; LCR to 00000011, disable DL, 8N1
    SETIO 03h
    WRITEIO 03h

; FCR to 00000111, reset and enable hardware FIFOs
    SETIO 02h
    WRITEIO 07h

; MCR to 00000000, no out1/out2
    SETIO 04h
    WRITEIO 00h

; IER to 00000000, no interrupts
; 00000010, transmit interrupt
; 00000001, receive interrupt
; 00000011, transmit & receive interrupt
    SETIO 01h
    WRITEIO 03h

    RETSUB

; print a single character from D
PRCHAR_SUB:
PRCHAR_WAIT:
    SEQ
    LOADREGLDN UARTSENDBUFFERHEAD, SCRATCHREG  ; D = head
    DEC STACK
    STR STACK                                 ; push head
    LOADREGLDN UARTSENDBUFFERTAIL, SCRATCHREG  ; D = tail
    SD                                          ; D = head - tail = bytes used
    INC STACK
    SMI 0ffh                                    ; DF=1 if full (255 bytes used)
    JDF PRCHAR_WAIT
    REQ
    DISABLE_INTERRUPTS
    LOADREG UARTSENDBUFFERHEAD, SCRATCHREG
    LDI (UARTOUTBUFFER >> 8)
    PHI UARTREG
    LDN SCRATCHREG
    PLO UARTREG
    INC STACK
    LDN STACK ; get byte to print off stack
    STR UARTREG ; store to head of buffer
    INC UARTREG ; in head pointer
    GLO UARTREG 
    STR SCRATCHREG ; write head pointer to memory
; enable UART send interrupt
    SETIO 01h
    INP 110b ; status byte in D
    ORI 02h ; make sure transmit buffer int bit is on
    STR STACK ; push new status byte to stack
    OUT 100b ; write 
    DEC STACK ; restore stack pointer
    ENABLE_INTERRUPTS
    RETSUB

PRBYTE_SUB:
    LDI (HEXTABLE >> 8)
    PHI SCRATCHREG
    INC STACK
    LDN STACK
    SHR
    SHR
    SHR
    SHR
    ADI (HEXTABLE & 0ffh) ; hex char table offset by 0xF0
    PLO SCRATCHREG
    LDN SCRATCHREG
    DEC STACK
    STR STACK
    DEC STACK
    GOSUB PRCHAR_SUB
    LDI (HEXTABLE >> 8)
    PHI SCRATCHREG
    INC STACK
    LDN STACK
    ANI 0Fh ; AND not ADD
    ADI (HEXTABLE & 0ffh) ; hex char table offset by 0xF0
    PLO SCRATCHREG
    LDN SCRATCHREG
    STR STACK
    DEC STACK
    GOSUB PRCHAR_SUB
    RETSUB

PRSTR:
    LDA ARGUMENTS
    JZ ENDPRSTR
    PRCHAR
    JMP PRSTR
ENDPRSTR:
    RETSUB

