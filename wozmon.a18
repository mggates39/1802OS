WOZREG equ USERREG0 ; wozmon use
WOZREG2 equ USERREG1
TARGETREG equ USERREG2 ; wozmon target
TARGETREG2 equ USERREG3 ; wozmon :to target

WOZMON:
    LBR HELPMENU
    LBR SKIPTIMERDISPLAY
NEWLINE:
; end timer

; display start and end times
    PRCRLF
    PRSTRING "Start: "
    DISPLAYCLOCK TIMERSTART
    PRCRLF
    PRSTRING "End:   "
;GETCLOCK TIMEBASE
    DISPLAYCLOCK TIMEBASE
    PRCRLF


SKIPTIMERDISPLAY:
    PRCRLF

    LDI ']'
    PRCHAR
    LDI 00h
    PHI  WOZREG
    PLO  WOZREG
    PHI  WOZREG2
    PLO  WOZREG2
    PHI  TARGETREG
    PLO  TARGETREG
    PHI  TARGETREG2
    PLO  TARGETREG2

; WOZREG points to Line buffer
    LOADREG WOZMONLINE, WOZREG 

; scratchreg points to receiveflag
    LOADREG UARTRECVNEWFLAG, WOZREG2

INPUTLOOP:

    LDN  WOZREG2
    BZ INPUTLOOP

    LDI (UARTINBUFFER >> 8) ;targetreg points to buffer tail
    PHI  TARGETREG
    LOADREGLDN UARTRECVBUFFERTAIL, TARGETREG2
    PLO  TARGETREG ; target reg holds buffer tail pointPRBYTE

    LDN  TARGETREG  
    STR  WOZREG
    PRCHAR
    INC  TARGETREG
    GLO  TARGETREG
    STR  TARGETREG2 ; incremented tail byte

    DISABLE_INTERRUPTS ; protect receiveflag
    LDN  WOZREG2
    SMI 01h
    STR  WOZREG2 ; decremented receive flag/counter
    ENABLE_INTERRUPTS

; check if we need to send xon and skip/send
    LDN  WOZREG2
    SMI 010h
    BDF SKIPSENDXON
    LOADREGLDN FLOWCONTROL, SCRATCHREG
    BZ SKIPSENDXON
    LDI 011h
    PRCHAR
    LOADREG FLOWCONTROL, SCRATCHREG
    LDI 00h
    STR  SCRATCHREG
SKIPSENDXON:

    LDN  WOZREG
    SDI 08h
    LBZ BACKSPACE
    LDN  WOZREG
    SDI 07Fh
    LBZ BACKSPACE
    LDN  WOZREG
    INC  WOZREG
    SMI 13 ; if it is enter, finish line
    BZ ENDLINE
    DEC  WOZREG
    LDN  WOZREG
    INC  WOZREG
    SMI 10 ; if it is linefeed, finish line
    BZ ENDLINE

    GLO  WOZREG
    SDI ((WOZMONLINE >> 8) + 79) ; if over 79 bytes, end input
    BZ ENDLINE
    LBR INPUTLOOP

ENDLINE: ; 1 extra CR wont hurt anyone
    LDI 013h
    STR  WOZREG

; start timer
    GETCLOCK TIMERSTART

    LOADREG WOZMONLINE, WOZREG ; reset wozmonline pointer
    LDI 00h
    PLO  TARGETREG
    PHI  TARGETREG
    PLO  TARGETREG2
    PHI  TARGETREG2

LOOP:
    LDN  WOZREG
    LBZ END
    SDI '='
    LBZ BEFOREEQUAL
    LDN  WOZREG
    SDI '.'
    LBZ PERIOD
    LDN  WOZREG
    SDI 13 ; enter
    LBZ SINGLEDISPLAY ; ENTER?
    LDN  WOZREG
    SDI 'G'
    LBZ EXECUTE
    LDN  WOZREG
    SDI 'g'
    LBZ EXECUTE
    LDN  WOZREG
    SDI ':'
    LBZ HEXLOADER
    LDN  WOZREG
    SDI 'R'
    LBZ RIO
    LDN  WOZREG
    SDI 'r'
    LBZ RIO
    LDN  WOZREG
    SDI 'W'
    LBZ WIO
    LDN  WOZREG
    SDI 'w'
    LBZ WIO
    LDN  WOZREG
    SDI '?'
    LBZ HELPMENU
    LDN  WOZREG
    XRI 030h
    ANI 0F0h
    LBZ digit
    LDN  WOZREG
    XRI 040h
    ANI 0D8h
    LBNZ NOTHEX
    LDN  WOZREG
    ANI 07h
    ADI 09h
    BR BOTH
DIGIT:
    LDN  WOZREG
    ANI 0Fh
BOTH:
    SHL
    SHL
    SHL
    SHL
    biglshift TARGETREG
    INC  WOZREG
    LBR LOOP

BACKSPACE:
    GLO  WOZREG
    XRI (WOZMONLINE & 0ffh)
    LBZ REDRAWPROMPT ; ignore keypress if first character
    LDI ' '
    PRCHAR
    LDI 08h
    PRCHAR
    DEC  WOZREG
    LBR INPUTLOOP

REDRAWPROMPT:
    LDI ']'
    PRCHAR
    LBR INPUTLOOP


EXECUTE:
    JUMPEXECUTE TARGETREG ; no coming back from this

PERIOD:
    INC  WOZREG
    LDN  WOZREG
    SDI 13
    LBZ DISPLAY ; ENTER?
    LDN  WOZREG
    XRI 030h
    ANI 0F0h
    BZ digit2
    LDN  WOZREG
    XRI 040h
    ANI 0D8h
    LBNZ NOTHEX
    LDN  WOZREG
    ANI 07h
    ADI 09h
    BR BOTH2
DIGIT2:
    LDN  WOZREG
    ANI 0Fh
BOTH2:
    SHL
    SHL
    SHL
    SHL
    biglshift TARGETREG2
    LBR PERIOD

BEFOREEQUAL:
; do not overwrite address 0
    GHI  TARGETREG
    BNZ CONTINUEEQUAL
    GLO  TARGETREG
    LBZ NEWLINE

CONTINUEEQUAL:
    LOADREG WOZWRITEHIGH, SCRATCHREG
    GHI  TARGETREG
    STR  SCRATCHREG
    LOADREG WOZWRITELOW, SCRATCHREG
    GLO  TARGETREG
    STR  SCRATCHREG
EQUAL:
    LDI 00h
    STR  TARGETREG ; target byte is now 0
EQUALLOOP:
    INC  WOZREG
    LDN  WOZREG
    SDI 13
    LBZ WRITEDISPLAY ; ENTER?
    LDN  WOZREG
    SDI ' '
    LBZ SPACE
    LDN  WOZREG
    XRI 030h
    ANI 0F0h
    LBZ digit3
    LDN  WOZREG
    XRI 040h
    ANI 0D8h
    LBNZ EQUALLOOP
    LDN  WOZREG
    ANI 07h
    ADI 09h
    BR BOTH3
DIGIT3:
    LDN  WOZREG
    ANI 0Fh
BOTH3:
    DEC  STACK
    STR  STACK
    LDN  TARGETREG
    SHL
    SHL
    SHL
    SHL
    ADD
    STR  TARGETREG
    INC  STACK
    LBR EQUALLOOP

SPACE: 
    INC  TARGETREG
    LBR EQUAL


WRITEDISPLAY:
; set targetend to last byte modified
    GHI  TARGETREG
    PHI  TARGETREG2
    GLO  TARGETREG
    PLO  TARGETREG2

;restore original target address
    LOADREGLDN WOZWRITEHIGH, SCRATCHREG
    PHI  TARGETREG
    LOADREGLDN WOZWRITELOW, SCRATCHREG
    PLO  TARGETREG
    LBR DISPLAY

; display code here
SINGLEDISPLAY:
    GHI  TARGETREG
    PHI  TARGETREG2
    GLO  TARGETREG
    PLO  TARGETREG2
DISPLAY:
    GHI  TARGETREG
    PHI  WOZREG2
    GLO  TARGETREG
    PLO  WOZREG2
    PRCRLF
    GHI  TARGETREG
    PRBYTE
    GLO  TARGETREG
    PRBYTE
    LDI '='
    PRCHAR
    EACHBYTE:
    LDN  TARGETREG
    PRBYTE
    LDI ' '
    PRCHAR

    DEC  STACK
    GHI  TARGETREG2
    STR  STACK
    GHI  TARGETREG
    SD 
    INC  STACK
    BNZ NOTEQUAL
    DEC  STACK
    GLO  TARGETREG2
    STR  STACK
    GLO  TARGETREG
    SD
    INC  STACK
    BZ BYTES

NOTEQUAL:
    INC  TARGETREG
    GLO  TARGETREG
; 0x7 for 8 bytes, 0xF for 16 bytes, 0x1F for 32 bytes
    ANI 0Fh
    BNZ EACHBYTE

BYTES:
    PRSTRING "  "
EACHCHAR:
    LDN  WOZREG2
    SMI 020h
    LBNF INVALIDCHAR
    LDN  WOZREG2
    LSKP
INVALIDCHAR:
    LDI '.'
    PRCHAR

    DEC  STACK
    GHI  TARGETREG2
    STR  STACK
    GHI  WOZREG2
    SD 
    INC  STACK
    LBNZ NOTEQUAL2

    DEC  STACK
    GLO  TARGETREG2
    STR  STACK
    GLO  WOZREG2
    SD
    INC  STACK
    LBZ NEWLINE

NOTEQUAL2:
    INC  WOZREG2
    GLO  WOZREG2
    ANI 0Fh
    LBNZ EACHCHAR

    LBR DISPLAY

HELPMENU:
    PRCRLF
    PRSTRINGCRLF "COSMAC ELF/J1802 - JMON HELP"
    PRSTRINGCRLF "=================================================================="
    PRSTRINGCRLF "Any missing arguments are assumed to be 0"
    PRCRLF
    PRSTRINGCRLF "AAAA          - Review byte at AAAA"
    PRSTRINGCRLF "AAAA.BBBB     - Review bytes from AAAA to BBBB"
    PRSTRINGCRLF "AAAA=CC DD ...- Set Byte at AAAA to CC, AAAA+1 to DD. 1 to 16 arguments."
    PRSTRINGCRLF "AAAAG         - Jump to AAAA and execute"
    PRSTRINGCRLF "ABR           - Read byte from IO Device A, register B"
    PRSTRINGCRLF "ABCCW         - Write byte CC to IO Device A, register B"
    PRSTRINGCRLF ":xxxxxxxxx    - For pasting Intel hex files"
    PRSTRINGCRLF "?             - Help (this screen)"
    PRCRLF
    PRWORD CLOCKDISPLAY
    PRSTRINGCRLF "G         - Clock (One time)"
    PRWORD CLOCKLOOPDISPLAY
    PRSTRINGCRLF "G         - Clock (Looping, Ctrl-C to exit)"
    PRWORD FIB256DISPLAY
    PRSTRING "G         - 0x"
    PRWORD (DATABYTES * 8)
    PRSTRINGCRLF " bit Fibonacci sequence"
    PRCRLF
    PRRANGE ROMSTART, (ENDBIOS-1)
    PRSTRINGCRLF "     - BIOS/ROM Image"
    PRRANGE UARTOUTBUFFER, (UARTOUTBUFFER + UARTBUFFERSIZE - 1)
    PRSTRING "     - UART Transmit Buffer | "
    PRRANGE UARTINBUFFER, (UARTINBUFFER + UARTBUFFERSIZE - 1)
    PRSTRINGCRLF " - UART Receive Buffer"
    PRRANGE (RETURNSTACKTOP - RETURNSTACKSIZE + 1), RETURNSTACKTOP
    PRSTRING "     - Sub Return Stack     | "
    PRRANGE (STACKTOP - STACKSIZE + 1), STACKTOP
    PRSTRINGCRLF " - Stack"
    PRRANGE USERRAM, 0FFFFh
    PRSTRINGCRLF "     - User RAM"
    PRCRLF
    PRSTRINGCRLF "Ctrl-\\ Hard boot to 0x0000 | Ctrl-Z Reboot with memory wipe | Ctrl-C warm boot"
    LBR SKIPTIMERDISPLAY

HEXLOADER:
; WOZREG is address of current pointer in command line
; WOZREG2 is loop counter for reading nibbles & byte to save
; TARGETREG is address to be written
; TARGETREG2 is count of bytes
    LDI 00h
    PLO  TARGETREG2
    PHI  TARGETREG2
    PLO  TARGETREG
    PHI  TARGETREG
    PLO  WOZREG2
    PHI  WOZREG2

; number of bytes
    INC  WOZREG
    LDN  WOZREG
    SDI 13 ; enter
    LBZ END ; unexpected ENTER? abort
    LDN  WOZREG
    XRI 030h
    ANI 0F0h
    LBZ DIGIT4
    LDN  WOZREG
    ANI 07h
    ADI 09h
    BR BOTH4
DIGIT4:
    LDN  WOZREG
    ANI 0Fh
BOTH4:
    SHL
    SHL
    SHL
    SHL
    PLO  TARGETREG2
    INC  WOZREG
    LDN  WOZREG
    SDI 13 ; enter
    LBZ END ; unexpected ENTER? abort
    LDN  WOZREG
    XRI 030h
    ANI 0F0h
    LBZ DIGIT5
    LDN  WOZREG
    ANI 07h
    ADI 09h
    LBR BOTH5
DIGIT5:
    LDN  WOZREG
    ANI 0Fh
BOTH5:
    DEC  STACK
    STR  STACK
    GLO  TARGETREG2
    ADD
    PLO  TARGETREG2
    INC  STACK
    GLO  TARGETREG2
    LBZ END
; end number of bytes

; target address
    LDI 04h
    PLO  WOZREG2
TARGET:
    INC  WOZREG
    LDN  WOZREG
    SDI 13
    LBZ END ; unexpected ENTER abort
    LDN  WOZREG
    XRI 030h
    ANI 0F0h
    LBZ DIGIT6
    LDN  WOZREG
    ANI 07h
    ADI 09h
    LBR BOTH6
DIGIT6:
    LDN  WOZREG
    ANI 0Fh
BOTH6:
    SHL
    SHL
    SHL
    SHL
    biglshift TARGETREG
    DEC  WOZREG2
    GLO  WOZREG2
    LBNZ TARGET ; not 4 nibbles, loop
; done target address

    INC  WOZREG ; skip two bytes of 'type'
    INC  WOZREG

;loop to eat bytes
EATBYTES:
    INC  WOZREG
    LDN  WOZREG
    SDI 13 ; enter
    LBZ END ; unexpected ENTER? abort
    LDN  WOZREG
    SDI 10 ; enter
    LBZ END ; unexpected ENTER? abort
    LDN  WOZREG
    XRI 030h
    ANI 0F0h
    LBZ DIGIT7
    LDN  WOZREG
    ANI 07h
    ADI 09h
    LBR BOTH7
DIGIT7:
    LDN  WOZREG
    ANI 0Fh
BOTH7:
    SHL
    SHL
    SHL
    SHL
    PLO  WOZREG2
    INC  WOZREG
    LDN  WOZREG
    SDI 13 ; enter
    LBZ END ; unexpected ENTER? abort
    LDN  WOZREG
    SDI 10 ; enter
    LBZ END ; unexpected ENTER? abort
    LDN  WOZREG
    XRI 030h
    ANI 0F0h
    LBZ DIGIT8
    LDN  WOZREG
    ANI 07h
    ADI 09h
    LBR BOTH8
DIGIT8:
    LDN  WOZREG
    ANI 0Fh
BOTH8:
    DEC  STACK
    STR  STACK
    GLO  WOZREG2
    ADD
    PLO  WOZREG2
    INC  STACK
    STR  TARGETREG
    INC  TARGETREG
    DEC  TARGETREG2
    GLO  TARGETREG2
    BNZ EATBYTES
    LBR END

RIO:
    PRCRLF
    DISABLE_INTERRUPTS
    GLO  TARGETREG
    DEC  STACK
    STR  STACK
    OUT 001b ;increments STACK, sets IO port
    DEC  STACK
    INP 110b ; reads IO byte
    INC  STACK
    PRBYTE
    ENABLE_INTERRUPTS
    PRSTRING " was read from device "
    GLO  TARGETREG
    ANI 0F0h
    SHR
    SHR
    SHR
    SHR
    PRBYTE
    PRSTRING ", port "
    GLO  TARGETREG
    ANI 0Fh
    PRBYTE
    PRCRLF
    LBR NEWLINE


WIO:
    PRCRLF
    DISABLE_INTERRUPTS
    GHI  TARGETREG
    DEC  STACK
    STR  STACK
    OUT 001b ;increments STACK sets IO port
    GLO  TARGETREG
    DEC  STACK
    STR  STACK
    OUT 100b ; increaments STACK, writes IO byte
    ENABLE_INTERRUPTS
    GLO  TARGETREG
    PRBYTE
    PRSTRING " was written to device "
    GHI  TARGETREG
    ANI 0F0h
    SHR
    SHR
    SHR
    SHR
    PRBYTE
    PRSTRING ", port "
    GHI  TARGETREG
    ANI 0Fh
    PRBYTE
    PRCRLF

END:
    LBR SKIPTIMERDISPLAY

NOTHEX:
    PRCRLF
    PRSTRINGCRLF "ERROR: Invalid Character"
    LBR END