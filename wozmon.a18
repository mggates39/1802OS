WOZREG equ USERREG0 ; wozmon use
WOZREG2 equ USERREG1
TARGETREG equ USERREG2 ; wozmon target
TARGETREG2 equ USERREG3 ; wozmon :to target

WOZMON:
LBR HELPMENU
LBR SKIPTIMERDISPLAY
NEWLINE:
; end timer
LOADREG TIMEREND, TARGETREG
DEC_R STACK
SETIO 0x17
INP 110b
STR_R TARGETREG
INC_R TARGETREG
SETIO 0x16
INP 110b
STR_R TARGETREG
INC_R TARGETREG
SETIO 0x15
INP 110b
STR_R TARGETREG
INC_R TARGETREG
SETIO 0x13
INP 110b
STR_R TARGETREG
INC_R TARGETREG
SETIO 0x12
INP 110b
STR_R TARGETREG
INC_R TARGETREG
SETIO 0x11
INP 110b
STR_R TARGETREG
INC_R TARGETREG
INC_R STACK    

; display start and end times
    PRCRLF
    PRSTRING "Start: "
    LOADREGLDN TIMERSTART, TARGETREG
    PRBYTE    
    PRSTRING "/"
    INC_R TARGETREG
    LDN_R TARGETREG
    PRBYTE    
    PRSTRING "/"
    INC_R TARGETREG
    LDN_R TARGETREG
    PRBYTE    
    PRSTRING " "
    INC_R TARGETREG
    LDN_R TARGETREG
    PRBYTE    
    PRSTRING ":"
    INC_R TARGETREG
    LDN_R TARGETREG
    PRBYTE    
    PRSTRING ":"
    INC_R TARGETREG
    LDN_R TARGETREG
    PRBYTE    
    INC_R TARGETREG
    PRCRLF
    PRSTRING "End:   "
    LDN_R TARGETREG
    PRBYTE    
    PRSTRING "/"
    INC_R TARGETREG
    LDN_R TARGETREG
    PRBYTE    
    PRSTRING "/"
    INC_R TARGETREG
    LDN_R TARGETREG
    PRBYTE    
    PRSTRING " "
    INC_R TARGETREG
    LDN_R TARGETREG
    PRBYTE    
    PRSTRING ":"
    INC_R TARGETREG
    LDN_R TARGETREG
    PRBYTE    
    PRSTRING ":"
    INC_R TARGETREG
    LDN_R TARGETREG
    PRBYTE    
    INC_R TARGETREG
    PRCRLF


SKIPTIMERDISPLAY:
PRCRLF

LDI ']'
PRCHAR
LDI 0x00
PHI_R WOZREG
PLO_R WOZREG
PHI_R WOZREG2
PLO_R WOZREG2
PHI_R TARGETREG
PLO_R TARGETREG
PHI_R TARGETREG2
PLO_R TARGETREG2

; WOZREG points to Line buffer
LOADREG WOZMONLINE, WOZREG 

; scratchreg points to receiveflag
LOADREG UARTRECVNEWFLAG, WOZREG2

INPUTLOOP:

LDN_R WOZREG2
BZ INPUTLOOP

LDI >UARTINBUFFER ;targetreg points to buffer tail
PHI_R TARGETREG
LOADREGLDN UARTRECVBUFFERTAIL, TARGETREG2
PLO_R TARGETREG ; target reg holds buffer tail pointPRBYTE

LDN_R TARGETREG  
STR_R WOZREG
PRCHAR
INC_R TARGETREG
GLO_R TARGETREG
STR_R TARGETREG2 ; incremented tail byte

DISABLE_INTERRUPTS ; protect receiveflag
LDN_R WOZREG2
SMI 0x01
STR_R WOZREG2 ; decremented receive flag/counter
ENABLE_INTERRUPTS

; check if we need to send xon and skip/send
LDN_R WOZREG2
SMI 0x10
LBDF SKIPSENDXON
LOADREGLDN FLOWCONTROL, SCRATCHREG
LBZ SKIPSENDXON
LDI 0x11
PRCHAR
LOADREG FLOWCONTROL, SCRATCHREG
LDI 0x00
STR_R SCRATCHREG
SKIPSENDXON:

LDN_R WOZREG
SDI 0x08
LBZ BACKSPACE
LDN_R WOZREG
SDI 0x7F
LBZ BACKSPACE
LDN_R WOZREG
INC_R WOZREG
SMI 13 ; if it is enter, finish line
BZ ENDLINE
DEC_R WOZREG
LDN_R WOZREG
INC_R WOZREG
SMI 10 ; if it is linefeed, finish line
BZ ENDLINE

GLO_R WOZREG
SDI <WOZMONLINE + 79 ; if over 79 bytes, end input
BZ ENDLINE
LBR INPUTLOOP

ENDLINE: ; 1 extra CR wont hurt anyone
LDI 0x13 
STR_R WOZREG

; start timer
DISABLE_INTERRUPTS
LOADREG TIMERSTART, TARGETREG
DEC_R STACK
SETIO 0x17
INP 110b
STR_R TARGETREG
INC_R TARGETREG
SETIO 0x16
INP 110b
STR_R TARGETREG
INC_R TARGETREG
SETIO 0x15
INP 110b
STR_R TARGETREG
INC_R TARGETREG
SETIO 0x13
INP 110b
STR_R TARGETREG
INC_R TARGETREG
SETIO 0x12
INP 110b
STR_R TARGETREG
INC_R TARGETREG
SETIO 0x11
INP 110b
STR_R TARGETREG
INC_R TARGETREG
INC_R STACK    
ENABLE_INTERRUPTS

LOADREG WOZMONLINE, WOZREG ; reset wozmonline pointer
LDI 0x00
PLO_R TARGETREG
PHI_R TARGETREG
PLO_R TARGETREG2
PHI_R TARGETREG2

LOOP:
LDN_R WOZREG
LBZ END
SDI '='
LBZ BEFOREEQUAL
LDN_R WOZREG
SDI '.'
LBZ PERIOD
LDN_R WOZREG
SDI 13 ; enter
LBZ SINGLEDISPLAY ; ENTER?
LDN_R WOZREG
SDI 'G'
LBZ EXECUTE
LDN_R WOZREG
SDI 'g'
LBZ EXECUTE
LDN_R WOZREG
SDI ':'
LBZ HEXLOADER
LDN_R WOZREG
SDI 'R'
LBZ RIO
LDN_R WOZREG
SDI 'W'
LBZ WIO
LDN_R WOZREG
SDI '?'
LBZ HELPMENU
LDN_R WOZREG
XRI 0x30
ANI 0xF0
LBZ digit
LDN_R WOZREG
XRI 0x40
ANI 0xD8
LBNZ NOTHEX
LDN_R WOZREG
ANI 0X07
ADI 0x09
LBR BOTH
DIGIT:
LDN_R WOZREG
ANI 0x0F
BOTH:
SHL
SHL
SHL
SHL
biglshift TARGETREG
INC_R WOZREG
LBR LOOP

BACKSPACE:
GLO_R WOZREG
XRI <WOZMONLINE
LBZ REDRAWPROMPT ; ignore keypress if first character
LDI ' '
PRCHAR
LDI 0x08
PRCHAR
DEC_R WOZREG
LBR INPUTLOOP

REDRAWPROMPT:
LDI ']'
PRCHAR
LBR INPUTLOOP


EXECUTE:
JUMPEXECUTE TARGETREG ; no coming back from this

PERIOD:
INC_R WOZREG
LDN_R WOZREG
SDI 13
LBZ DISPLAY ; ENTER?
LDN_R WOZREG
XRI 0x30
ANI 0xF0
LBZ digit2
LDN_R WOZREG
XRI 0x40
ANI 0xD8
LBNZ NOTHEX
LDN_R WOZREG
ANI 0X07
ADI 0x09
LBR BOTH2
DIGIT2:
LDN_R WOZREG
ANI 0x0F
BOTH2:
SHL
SHL
SHL
SHL
biglshift TARGETREG2
LBR PERIOD

BEFOREEQUAL:
LOADREG WOZWRITEHIGH, SCRATCHREG
GHI_R TARGETREG
STR_R SCRATCHREG
LOADREG WOZWRITELOW, SCRATCHREG
GLO_R TARGETREG
STR_R SCRATCHREG
EQUAL:
LDI 0x0
STR_R TARGETREG ; target byte is now 0
EQUALLOOP:
INC_R WOZREG
LDN_R WOZREG
SDI 13
LBZ WRITEDISPLAY ; ENTER?
LDN_R WOZREG
SDI ' '
LBZ SPACE
LDN_R WOZREG
XRI 0x30
ANI 0xF0
LBZ digit3
LDN_R WOZREG
XRI 0x40
ANI 0xD8
LBNZ EQUALLOOP
LDN_R WOZREG
ANI 0X07
ADI 0x09
LBR BOTH3
DIGIT3:
LDN_R WOZREG
ANI 0x0F
BOTH3:
DEC_R STACK
STR_R STACK
LDN_R TARGETREG
SHL
SHL
SHL
SHL
ADD
STR_R TARGETREG
INC_R STACK
LBR EQUALLOOP

SPACE: 
INC_R TARGETREG
LBR EQUAL


WRITEDISPLAY:
; set targetend to last byte modified
GHI_R TARGETREG
PHI_R TARGETREG2
GLO_R TARGETREG
PLO_R TARGETREG2

;restore original target address
LOADREGLDN WOZWRITEHIGH, SCRATCHREG
PHI_R TARGETREG
LOADREGLDN WOZWRITELOW, SCRATCHREG
PLO_R TARGETREG
LBR DISPLAY

; display code here
SINGLEDISPLAY:
GHI_R TARGETREG
PHI_R TARGETREG2
GLO_R TARGETREG
PLO_R TARGETREG2
DISPLAY:
GHI_R TARGETREG
PHI_R WOZREG2
GLO_R TARGETREG
PLO_R WOZREG2
PRCRLF
GHI_R TARGETREG
PRBYTE
GLO_R TARGETREG
PRBYTE
LDI '='
PRCHAR
EACHBYTE:
LDN_R TARGETREG
PRBYTE
LDI ' '
PRCHAR

DEC_R STACK
GHI_R TARGETREG2
STR_R STACK
GHI_R TARGETREG
SD 
INC_R STACK
LBNZ NOTEQUAL
DEC_R STACK
GLO_R TARGETREG2
STR_R STACK
GLO_R TARGETREG
SD
INC_R STACK
LBZ BYTES

NOTEQUAL:
INC_R TARGETREG
GLO_R TARGETREG
; 0x7 for 8 bytes, 0xF for 16 bytes, 0x1F for 32 bytes
ANI 0x0F
LBNZ EACHBYTE

BYTES:
PRSTRING "  "
EACHCHAR:
LDN_R WOZREG2
SMI 0x20
LBNF INVALIDCHAR
LDN_R WOZREG2
SMI 0x7F
LBDF INVALIDCHAR
LDN_R WOZREG2
LSKP
INVALIDCHAR:
LDI '.'
PRCHAR

DEC_R STACK
GHI_R TARGETREG2
STR_R STACK
GHI_R WOZREG2
SD 
INC_R STACK
LBNZ NOTEQUAL2

DEC_R STACK
GLO_R TARGETREG2
STR_R STACK
GLO_R WOZREG2
SD
INC_R STACK
LBZ NEWLINE

NOTEQUAL2:
INC_R WOZREG2
GLO_R WOZREG2
ANI 0x0F
LBNZ EACHCHAR

LBR DISPLAY

HELPMENU:
PRCRLF
PRSTRINGCRLF "COSMAC ELF/J1802 - JMON HELP"
PRSTRINGCRLF "=================================================================="
PRSTRINGCRLF "Any missing arguments are assumed to be 0"
PRCRLF
PRSTRINGCRLF "AAAA          - Review byte at AAAA"
PRSTRINGCRLF "AAAA.BBBB     - Review bytes from AAAA to BBBB"
PRSTRINGCRLF "AAAA=CC DD ...- Set Byte at AAAA to CC, AAAA+1 to DD. 1 to 16 arguments."
PRSTRINGCRLF "AAAAG         - Jump to AAAA and execute"
PRSTRINGCRLF "ABR           - Read byte from IO Device A, register B"
PRSTRINGCRLF "ABCCW         - Write byte CC to IO Device A, register B"
PRSTRINGCRLF ":xxxxxxxxx    - For pasting Intel hex files"
PRSTRINGCRLF "?             - Help (this screen)"
PRCRLF
PRWORD CLOCKDISPLAY
PRSTRINGCRLF "G         - Clock (One time)"
PRWORD CLOCKLOOPDISPLAY
PRSTRINGCRLF "G         - Clock (Looping, Ctrl-C to exit)"
PRWORD FIB256DISPLAY
PRSTRING "G         - 0x"
PRWORD DATABYTES * 8
PRSTRINGCRLF " bit Fibonacci sequence"
PRCRLF
PRRANGE ROMSTART, ENDBIOS-1
PRSTRINGCRLF "     - BIOS/ROM Image"
PRRANGE UARTOUTBUFFER, UARTOUTBUFFER + UARTBUFFERSIZE - 1
PRSTRING "     - UART Transmit Buffer | "
PRRANGE UARTINBUFFER, UARTINBUFFER + UARTBUFFERSIZE - 1
PRSTRINGCRLF " - UART Receive Buffer"
PRRANGE RETURNSTACKTOP - RETURNSTACKSIZE + 1, RETURNSTACKTOP
PRSTRING "     - Sub Return Stack     | "
PRRANGE STACKTOP - STACKSIZE + 1, STACKTOP
PRSTRINGCRLF " - Stack"
PRRANGE USERRAM, 0xFFFF
PRSTRINGCRLF "     - User RAM"
PRCRLF
PRSTRINGCRLF "Ctrl-\\ Hard boot to 0x0000 | Ctrl-Z Reboot with memory wipe | Ctrl-C warm boot"
LBR SKIPTIMERDISPLAY

HEXLOADER:
; WOZREG is address of current pointer in command line
; WOZREG2 is loop counter for reading nibbles & byte to save
; TARGETREG is address to be written
; TARGETREG2 is count of bytes
LDI 0x00 
PLO_R TARGETREG2
PHI_R TARGETREG2
PLO_R TARGETREG
PHI_R TARGETREG
PLO_R WOZREG2
PHI_R WOZREG2

; number of bytes
INC_R WOZREG
LDN_R WOZREG
SDI 13 ; enter
LBZ END ; unexpected ENTER? abort
LDN_R WOZREG
XRI 0x30
ANI 0xF0
LBZ DIGIT4
LDN_R WOZREG
ANI 0X07
ADI 0x09
LBR BOTH4
DIGIT4:
LDN_R WOZREG
ANI 0x0F
BOTH4:
SHL
SHL
SHL
SHL
PLO_R TARGETREG2
INC_R WOZREG
LDN_R WOZREG
SDI 13 ; enter
LBZ END ; unexpected ENTER? abort
LDN_R WOZREG
XRI 0x30
ANI 0xF0
LBZ DIGIT5
LDN_R WOZREG
ANI 0X07
ADI 0x09
LBR BOTH5
DIGIT5:
LDN_R WOZREG
ANI 0x0F
BOTH5:
DEC_R STACK
STR_R STACK
GLO_R TARGETREG2
ADD
PLO_R TARGETREG2
INC_R STACK
GLO_R TARGETREG2
LBZ END
; end number of bytes

; target address
LDI 0x04
PLO_R WOZREG2
TARGET:
INC_R WOZREG
LDN_R WOZREG
SDI 13
LBZ END ; unexpected ENTER abort
LDN_R WOZREG
XRI 0x30
ANI 0xF0
LBZ DIGIT6
LDN_R WOZREG
ANI 0X07
ADI 0x09
LBR BOTH6
DIGIT6:
LDN_R WOZREG
ANI 0x0F
BOTH6:
SHL
SHL
SHL
SHL
biglshift TARGETREG
DEC_R WOZREG2
GLO_R WOZREG2
LBNZ TARGET ; not 4 nibbles, loop
; done target address

INC_R WOZREG ; skip two bytes of 'type'
INC_R WOZREG

;loop to eat bytes
EATBYTES:
INC_R WOZREG
LDN_R WOZREG
SDI 13 ; enter
LBZ END ; unexpected ENTER? abort
LDN_R WOZREG
SDI 10 ; enter
LBZ END ; unexpected ENTER? abort
LDN_R WOZREG
XRI 0x30
ANI 0xF0
LBZ DIGIT7
LDN_R WOZREG
ANI 0X07
ADI 0x09
LBR BOTH7
DIGIT7:
LDN_R WOZREG
ANI 0x0F
BOTH7:
SHL
SHL
SHL
SHL
PLO_R WOZREG2
INC_R WOZREG
LDN_R WOZREG
SDI 13 ; enter
LBZ END ; unexpected ENTER? abort
LDN_R WOZREG
SDI 10 ; enter
LBZ END ; unexpected ENTER? abort
LDN_R WOZREG
XRI 0x30
ANI 0xF0
LBZ DIGIT8
LDN_R WOZREG
ANI 0X07
ADI 0x09
LBR BOTH8
DIGIT8:
LDN_R WOZREG
ANI 0x0F
BOTH8:
DEC_R STACK
STR_R STACK
GLO_R WOZREG2
ADD
PLO_R WOZREG2
INC_R STACK
STR_R TARGETREG
INC_R TARGETREG
DEC_R TARGETREG2
GLO_R TARGETREG2
LBNZ EATBYTES
LBR END

RIO:
PRCRLF
DISABLE_INTERRUPTS
GLO_R TARGETREG
DEC_R STACK
STR_R STACK
OUT 001b ;increments STACK, sets IO port
DEC_R STACK
INP 110b ; reads IO byte
INC_R STACK
PRBYTE
ENABLE_INTERRUPTS
PRSTRING " was read from device "
GLO_R TARGETREG
ANI 0xF0
SHR
SHR
SHR
SHR
PRBYTE
PRSTRING ", port "
GLO_R TARGETREG
ANI 0x0F
PRBYTE
PRCRLF
LBR NEWLINE


WIO:
PRCRLF
DISABLE_INTERRUPTS
GHI_R TARGETREG
DEC_R STACK
STR_R STACK
OUT 001b ;increments STACK sets IO port
GLO_R TARGETREG
DEC_R STACK
STR_R STACK
OUT 100b ; increaments STACK, writes IO byte
ENABLE_INTERRUPTS
GLO_R TARGETREG
PRBYTE
PRSTRING " was written to device "
GHI_R TARGETREG
ANI 0xF0
SHR
SHR
SHR
SHR
PRBYTE
PRSTRING ", port "
GHI_R TARGETREG
ANI 0x0F
PRBYTE
PRCRLF

END:
LBR SKIPTIMERDISPLAY

NOTHEX:
PRCRLF
PRSTRINGCRLF "ERROR: Invalid Character"
LBR END